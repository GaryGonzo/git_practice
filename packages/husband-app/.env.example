# Supabase project settings (Project Settings > API). This app is a separate
# Supabase project from Golfable's -- create a new one and paste its keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID public key for Web Push (safe to expose in the client bundle -- it's
# the private key that must stay secret, set only as a Supabase Edge
# Function secret, never here).
VITE_VAPID_PUBLIC_KEY=
