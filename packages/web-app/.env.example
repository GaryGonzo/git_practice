# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key (Developers > API keys). Never put the secret key here —
# checkout session creation must happen server-side (e.g. a Supabase Edge Function).
VITE_STRIPE_PUBLISHABLE_KEY=

# Web push VAPID public key -- pairs with VAPID_PRIVATE_KEY, which is a
# server-only secret set in the Vercel project (never here). Along with it,
# the /api/send-daily-notifications function needs these set as Vercel
# project environment variables, not in this file:
#   VAPID_PRIVATE_KEY, VAPID_SUBJECT, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET
VITE_VAPID_PUBLIC_KEY=

# Billing (Stripe) is handled entirely server-side by the /api functions
# (create-checkout-session, create-portal-session, create-studio,
# join-studio, stripe-webhook) -- none of this belongs in this file. Set
# these as Vercel project environment variables instead:
#   STRIPE_SECRET_KEY        Developers > API keys (use the sandbox key while testing)
#   STRIPE_WEBHOOK_SECRET    Developers > Webhooks > your endpoint > Signing secret
#   STRIPE_PRICE_TIER_799    Price ID for the $7.99/mo individual tier
#   STRIPE_PRICE_TIER_1499   Price ID for the $14.99/mo individual tier
#   STRIPE_PRICE_TIER_1999   Price ID for the $19.99/mo individual tier
#   SUPABASE_URL             Same project as VITE_SUPABASE_URL above
#   SUPABASE_ANON_KEY        Same project as VITE_SUPABASE_ANON_KEY above
#   SUPABASE_SERVICE_ROLE_KEY  Project Settings > API -- bypasses RLS, keep this out of client code entirely
# Sandbox and live mode have entirely different Price IDs for the same
# tier, so double check these when moving from testing to production.
